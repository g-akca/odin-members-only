<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="/tailwind.css" rel="stylesheet">
    <title>Members Only - Log In</title>
  </head>
  <body class="flex flex-col">
    <%- include("partials/header.ejs") %>

    <form method="POST" action="/login" class="p-4 flex flex-col items-center gap-4 max-w-lg self-center">
      <%- include("partials/errors.ejs") %>

      <div class="w-full grid grid-cols-2 gap-8">
        <label for="email" class="justify-self-end self-center">Email Address:</label>

        <input type="email" id="email" name="email" class="w-full px-2 py-1 border rounded" value="<%= locals.values?.email || "" %>" required>
      </div>

      <div class="w-full grid grid-cols-2 gap-8">
        <label for="password" class="justify-self-end self-center">Password:</label>

        <input type="password" id="password" name="password" min="8" class="w-full px-2 py-1 border rounded" required>
      </div>

      <button type="submit" class="px-4 py-1 rounded-lg bg-blue-500 text-white mt-4 cursor-pointer">Log In</button>
    </form>
  </body>
</html>