<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="/tailwind.css" rel="stylesheet">
    <title>Members Only - An Anonymous Message App</title>
  </head>
  <body>
    <%- include("partials/header.ejs") %>

    <main class="p-6 flex flex-col items-center gap-8">
      <% if (user) { %>
        <a href="/messages/new" class="px-7 py-2 bg-blue-500 text-white rounded-xl">Post New Message</a>
      <% } %>

      <div class="w-full max-w-xl flex flex-col gap-4">
        <% messages.map(message => { %>
          <div class="border p-4 rounded-xl">
            <% if (user?.is_member) { %>
              <div class="flex gap-6 items-center justify-between">
                <p class="font-semibold">By: <%= `${message.first_name} ${message.last_name}` %></p>
                <p><%= new Date(message.timestamp).toLocaleString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' }) %></p>
              </div>
            <% } %>

            <h2 class="font-bold text-[20px]"><%= message.title %></h2>
            <p><%= message.message %></p>
          </div>
        <% }) %>
      </div>
    </main>
  </body>
</html>