<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="/tailwind.css" rel="stylesheet">
    <title>Members Only - New Message</title>
  </head>
  <body class="flex flex-col">
    <%- include("partials/header.ejs") %>

    <form method="POST" action="/messages" class="p-4 flex flex-col items-center gap-4 max-w-lg w-full self-center">
      <%- include("partials/errors.ejs") %>

      <div class="w-full flex flex-col gap-2">
        <label for="title">Title</label>

        <input type="text" id="title" name="title" placeholder="Enter a title..." class="w-full px-2 py-1 border rounded" required>
      </div>

      <div class="w-full flex flex-col gap-2">
        <label for="message">Message</label>

        <textarea id="message" name="message" placeholder="Enter a message..." rows="4" class="w-full px-2 py-1 border rounded" required></textarea>
      </div>

      <button type="submit" class="px-5 py-1 rounded-lg bg-blue-500 text-white mt-4 cursor-pointer">Post Message</button>
    </form>
  </body>
</html>